{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // News generation reads BOTANICAL_RELEASE_BUILD_MODE: continuous release
    // rehearsals build before the claimed changelog entry exists. Both tasks
    // that run the compiler declare it, because a nested clean-checkout build
    // (scripts/cold-build.test.mjs) sees only this committed config, not the
    // globalEnv that release-build.mjs stages in the candidate checkout.
    "whats-new": {
      "dependsOn": [],
      "env": ["BOTANICAL_RELEASE_BUILD_MODE"],
      "inputs": [
        "$TURBO_ROOT$/apps/docs/src/content/docs/changelog.mdx",
        "$TURBO_ROOT$/tooling/release/{whats-new,changelog-gate,changelog-claims,data-impact}.mjs",
        "$TURBO_ROOT$/tooling/release/{fungi-version,data-impact-owners}.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
      ],
      "outputs": [".botanical/whats-new.json"],
    },
    // TUI's React 19 Parakeet copy lives in pnpm's virtual store. Its files
    // must be synchronized after a fresh build or a restored build artifact.
    // The build script reruns the news compiler for direct `pnpm run build`.
    "build": {
      "env": ["BOTANICAL_RELEASE_BUILD_MODE"],
      "dependsOn": [
        "^build",
        "@fungi.computer/parakeet#sync:injected",
        "whats-new",
      ],
    },
    "lint": {
      "dependsOn": ["^build", "@fungi.computer/parakeet#sync:injected"],
    },
    "typecheck": {
      "dependsOn": ["^build", "@fungi.computer/parakeet#sync:injected"],
    },
    // Runs the cached clean-checkout regression beside the host proof.
    "test:merge": {
      "dependsOn": ["test:cold-build"],
      "cache": false,
      "outputs": [],
    },
    // The clean-checkout regression builds only its disposable clone of HEAD,
    // not this workspace, so it needs no build here. It proves pnpm's injected
    // Parakeet sync after a Turbo restore and the closure's cache-key
    // stability; TUI and dependency source breakage is the gate's own build
    // and typecheck. Cache it on what the proof exercises: install inputs,
    // the Turbo wrapper and every workspace task config, and the Parakeet/TUI
    // manifests and compiler configs.
    "test:cold-build": {
      "dependsOn": [],
      "env": ["BOTANICAL_RELEASE_BUILD_MODE"],
      "outputs": [],
      "inputs": [
        "package.json",
        "turbo.jsonc",
        "tsconfig*.json",
        "scripts/cold-build.test.mjs",
        "$TURBO_ROOT$/packages/parakeet/{package.json,turbo.jsonc,tsconfig*.json}",
        "$TURBO_ROOT$/{package.json,turbo.jsonc,pnpm-workspace.yaml,pnpm-lock.yaml}",
        "$TURBO_ROOT$/tooling/repository/scripts/turbo.mjs",
        "$TURBO_ROOT$/*/*/turbo.{json,jsonc}",
      ],
    },
  },
}
